APP_NAME="Vive el Arte"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────────────────────────────
# Base de datos
# ──────────────────────────────────────────────────────────────────────────────
# PostgreSQL, no MySQL: la migración 2026_05_20_convert_core_text_to_jsonb usa
# `ALTER COLUMN ... TYPE jsonb`, que es sintaxis exclusiva de Postgres. Sobre
# MySQL esa migración falla y los textos bilingües de productos, publicaciones
# y categorías se quedan sin su estructura por idioma.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vivelarte
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ──────────────────────────────────────────────────────────────────────────────
# SPA de React
# ──────────────────────────────────────────────────────────────────────────────
# Origen del frontend, para CORS (config/cors.php lo lee). En desarrollo es el
# servidor de Vite; en producción, el dominio público.
FRONTEND_URL=http://localhost:5173

# Dominios que reciben cookie de sesión de Sanctum. Va sin protocolo y separado
# por comas. En producción tiene que incluir el dominio real, o el login por
# cookie responde 419 sin ninguna explicación.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# ──────────────────────────────────────────────────────────────────────────────
# Cloudinary — almacenamiento de imágenes (app/Traits/UploadsToCloudinary.php)
# ──────────────────────────────────────────────────────────────────────────────
# Una sola URL con las credenciales adentro: cloudinary://<key>:<secret>@<cloud>
CLOUDINARY_URL=
CLOUDINARY_UPLOAD_PRESET=

# ──────────────────────────────────────────────────────────────────────────────
# OpenAI — moderación automática de publicaciones (app/Jobs/ModeratePostJob.php)
# ──────────────────────────────────────────────────────────────────────────────
# Sin esta clave el job de moderación falla; el resto del sitio funciona igual.
OPENAI_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Correo — recuperación de contraseña y correo del manifiesto
# ──────────────────────────────────────────────────────────────────────────────
# Con MAIL_MAILER=log los correos se escriben en storage/logs en vez de enviarse,
# que es lo que se quiere en desarrollo.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hola@vivelarte.com"
MAIL_FROM_NAME="${APP_NAME}"
